
INTEGER CurMsgTxt

' The body of the message the preview is showing, split into lines once.
STRING PreviewLine[]
INTEGER PreviewCount

PROCEDURE LoadPreview(LONG MsgNum)
    MSG Body = MsgArea.Read(MsgNum)
    PreviewCount = 0
    IF !Body.Valid THEN
        RETURN
    ENDIF
    PreviewLine = Body.Text().Replace(Chr(13), "").Split(Chr(10))
    PreviewCount = PreviewLine.Len()
ENDPROC

PROCEDURE DrawMsgText()
    INTEGER ActualMsgNum = GetActualMessageNumber(Cursor)
    IF ActualMsgNum == -1 THEN
        CurMsgTxt = -1
        PreviewCount = 0
        ClrHdrArea()
        AnsiPos MsgHdrX1, MsgHdrY1
        COLOR 11
        PRINT "No valid message"
        DefColor
        RETURN
    ENDIF

    IF CurMsgTxt != ActualMsgNum THEN
        CurMsgTxt = ActualMsgNum
        LoadPreview(ActualMsgNum)
    ENDIF

    ' Never scroll past the last line, so paging down on a short message stops.
    IF FirstTxtLine >= PreviewCount THEN
        FirstTxtLine = PreviewCount - (MsgHdrY2 - MsgHdrY1)
        IF FirstTxtLine < 0 THEN
            FirstTxtLine = 0
        ENDIF
    ENDIF

    INTEGER msg_line = 0
    Color 7
    WHILE MsgHdrY1 + msg_line <= MsgHdrY2 DO
        IF msg_line + MsgHdrY1 > 23 BREAK
        AnsiPos MsgHdrX1, MsgHdrY1 + msg_line
        INTEGER Source = FirstTxtLine + msg_line
        IF Source < PreviewCount THEN
            PRINT Left(PreviewLine[Source], MsgHdrX2 - MsgHdrX1)
            ClrEOL
        ELSE
            PRINT Space(MsgHdrX2 - MsgHdrX1)
        ENDIF
        msg_line += 1
    ENDWHILE
    DefColor
ENDPROC

PROCEDURE ClrHdrArea()
    INTEGER I
    FOR I = 0 TO Lines
        AnsiPos MsgHdrX1, MsgHdrY1 + I
        Print Space(MsgHdrX2 - MsgHdrX1)
    NEXT
ENDPROC