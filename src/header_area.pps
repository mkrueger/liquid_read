
PROCEDURE DrawHeaderArea()
    
    IF !MessageIndexBuilt THEN
        BuildMessageIndex()
    ENDIF

    IF LastFirstMsg != FirstMsg THEN
        LastFirstMsg = FirstMsg
        Redraw = TRUE
    ELSE 
        Redraw = FALSE
    ENDIF
    FOR I = 0 TO Lines
        INTEGER O = FirstMsg + I
        IF O >= ValidMessageCount THEN
            DefColor
            AnsiPos AreaX, AreaY + I
            ClrEOL
            CONTINUE
        ENDIF

        IF !Redraw && O != Cursor && O != OldCursor THEN
            CONTINUE
        ENDIF

        AnsiPos AreaX, AreaY + I
        IF O == Cursor THEN
            Print SELECTED_MSG_HDR_ATTRIBUTE
        ELSE
            Print MSG_HDR_ATTRIBUTE
        ENDIF 
        
        INTEGER MSG_NUM = GetActualMessageNumber(O)
        
        IF MSG_NUM == -1 THEN
            DefColor
            ClrEOL
            CONTINUE
        ENDIF
        

        IF FROM[O] == "" THEN 
            ' One header read answers everything the list column needs.
            MSG Header = MsgArea.Read(MSG_NUM)
            FROM[O] = Left(StripATX(Header.From), 12) + " "
            SUBJ[O] = Left(StripATX(Header.Subject), 36) + " "
            TO[O] = Left(StripATX(Header.To), 12) + " "
            DATETXT[O] = STRING(Header.Date)
        ENDIF
        Print Right(STRING(MSG_NUM), 4), " ", SUBJ[o], FROM[o], TO[o], DATETXT[O]
    NEXT
    OldCursor = Cursor
    DefColor
ENDPROC
